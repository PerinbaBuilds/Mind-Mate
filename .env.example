# Choose ONE provider. Groq is free + very fast (recommended for the demo).
# LLM_PROVIDER=groq | anthropic | mock
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys, free tier) ---
GROQ_API_KEY=
# Leave GROQ_MODEL blank to auto-pick the best model your account can access.
# Groq rotates its lineup, so pinning a name here can 404 later.
GROQ_MODEL=

# --- Anthropic (optional alternative) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Sqlite path for user memory / session log
MIND_MATE_DB=data/mindmate.db
