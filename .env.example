# Copy this file to .env and fill in your key.
# If ANTHROPIC_API_KEY is not set, the app runs in an offline "mock" mode
# so you can still demo the interface end-to-end.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Sqlite path for user memory / session log
MIND_MATE_DB=data/mindmate.db
